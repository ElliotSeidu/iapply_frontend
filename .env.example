# Base URL of the iApply Django backend API (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000


# Google OAuth 2.0 Web client ID (Google Cloud Console). NOT a secret.
# Must equal GOOGLE_CLIENT_ID in the backend .env.
# Leave blank to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=
