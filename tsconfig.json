{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "target": "ES2022",
        "strict": true
    },
    "include": ["src"]
}
